+\
+.home-hero-shell \{\
+  position: relative;\
+  isolation: isolate;\
+  background:\
+    radial-gradient(circle at 78% 10%, rgba(247, 147, 26, 0.35), transparent 22rem),\
+    radial-gradient(circle at 4% 95%, rgba(232, 98, 124, 0.18), transparent 24rem),\
+    linear-gradient(125deg, rgba(255, 255, 255, 0.93), rgba(255, 244, 228, 0.78));\
+  box-shadow: 0 20px 70px rgba(113, 65, 16, 0.11);\
+\}\
+\
+.home-hero-shell::before \{\
+  position: absolute;\
+  z-index: -1;\
+  inset: 0;\
+  opacity: 0.32;\
+  background-image: linear-gradient(rgba(121, 82, 40, 0.09) 1px, transparent 1px), linear-gradient(90deg, rgba(121, 82, 40, 0.09) 1px, transparent 1px);\
+  background-size: 2.5rem 2.5rem;\
+  content: "";\
+  mask-image: linear-gradient(135deg, #000, transparent 80%);\
+\}\
+\
+.dark .home-hero-shell \{\
+  background:\
+    radial-gradient(circle at 78% 10%, rgba(247, 147, 26, 0.24), transparent 22rem),\
+    radial-gradient(circle at 4% 95%, rgba(199, 72, 99, 0.15), transparent 24rem),\
+    linear-gradient(125deg, rgba(36, 27, 21, 0.98), rgba(45, 31, 21, 0.95));\
+\}\
+\
+.home-kicker \{\
+  display: flex;\
+  align-items: center;\
+  gap: 0.65rem;\
+\}\
+\
+.home-kicker::before \{\
+  width: 0.65rem;\
+  height: 0.65rem;\
+  flex: 0 0 auto;\
+  border-radius: 999px;\
+  background: var(--primary);\
+  box-shadow: 0 0 0 0.38rem rgba(247, 147, 26, 0.15);\
+  content: "";\
+\}\
+\
+.home-title \{\
+  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);\
+\}\
+\
+.dark .home-title \{ text-shadow: none; \}\
+\
+.home-hero-visual \{\
+  transform: rotate(2deg);\
+\}\
+\
+.home-hero-visual img \{ transition: transform 600ms ease; \}\
+.home-hero-shell:hover .home-hero-visual img \{ transform: scale(1.035); \}\
+\
+.home-trust-strip \{\
+  background-image: linear-gradient(90deg, rgba(247, 147, 26, 0.06), transparent 34%, rgba(44, 126, 120, 0.08));\
+\}\
+\
+.next-event \{\
+  background: linear-gradient(120deg, var(--card), color-mix(in srgb, var(--card) 82%, var(--accent)));\
+  box-shadow: 0 18px 48px rgba(91, 55, 18, 0.09);\
+  transition: transform 180ms ease, box-shadow 180ms ease;\
+\}\
+\
+.next-event:hover \{\
+  transform: translateY(-3px);\
+  box-shadow: 0 26px 60px rgba(91, 55, 18, 0.15);\
+\}\
+\
+@media (max-width: 640px) \{\
+  .home-hero-shell \{ border-radius: 1.9rem; \}\
+  .home-hero-visual \{ transform: none; \}\
+\}\
+\
+@media (prefers-reduced-motion: reduce) \{\
+  .home-hero-visual img, .next-event \{ transition: none; \}\
+  .next-event:hover \{ transform: none; \}\
+\}\
