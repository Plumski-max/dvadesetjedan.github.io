diff --git a/src/components/EventGallery.tsx b/src/components/EventGallery.tsx\
new file mode 100644\
index 0000000..4a03dae\
--- /dev/null\
+++ b/src/components/EventGallery.tsx\
@@ -0,0 +1,36 @@\
+import \{ OptimizedImage \} from "@/components/OptimizedImage"\
+import \{ eventGalleryImages \} from "@/data/eventGallery"\
+\
+type EventGalleryProps = \{\
+  compact?: boolean\
+\}\
+\
+export function EventGallery(\{ compact = false \}: EventGalleryProps) \{\
+  return (\
+    <div\
+      className=\{`event-gallery grid gap-3 $\{\
+        compact ? "sm:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-3"\
+      \}`\}\
+    >\
+      \{eventGalleryImages.map((image, index) => (\
+        <figure\
+          className=\{`group overflow-hidden rounded-[1.5rem] bg-muted $\{\
+            !compact && index === 0 ? "sm:col-span-2 lg:col-span-1" : ""\
+          \}`\}\
+          key=\{image.src\}\
+        >\
+          <OptimizedImage\
+            alt=\{image.alt\}\
+            className=\{`h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none $\{\
+              compact ? "aspect-[4/3]" : "aspect-[4/3]"\
+            \}`\}\
+            pictureClassName="block h-full"\
+            src=\{image.src\}\
+            width=\{1440\}\
+            height=\{960\}\
+          />\
+        </figure>\
+      ))\}\
+    </div>\
+  )\
+\}\
